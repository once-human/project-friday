# Friday settings (sourced by friday-ask). Uncomment to change.
# This file is git-ignored once copied to brain/config.env: put anything personal here, never in the repo.
# FRIDAY_MODEL=sonnet            # faster/cheaper; leave unset to use your Claude Code default
# CLAUDE_BIN=$HOME/.local/bin/claude

# ---- about you (more in brain/me.md)
# FRIDAY_NAME="Sam"                        # what Friday calls you (default: first name on your account)
# FRIDAY_STYLE="casual, short, a bit of slang"   # how you talk; on-device replies are phrased to match
# FRIDAY_ROM_DIRS="~/aosp ~/lineage"       # Android ROM build trees, so the panel can tell you a build is running
# FRIDAY_MUSIC="Fred again.., afro house, melodic techno, lofi"   # artists and genres you like, favourites first
#                                         # (drives "play something nice" and the panel's music row; it also learns
#                                         #  from what you play, like and skip)

# ---- backup brain: answers when Claude's usage limit is reached (free; pick one, the first that works is used)
# GEMINI_API_KEY=...                      # best free option: Gemini Flash, key at https://aistudio.google.com/apikey
# GROQ_API_KEY=...                        # very fast, free key at https://console.groq.com/keys (gpt-oss-120b)
# OPENROUTER_API_KEY=...                  # OpenRouter's free models, https://openrouter.ai/keys
#                                         # or install Ollama (https://ollama.com) and pull a model: fully local, no key
# FRIDAY_FALLBACK=auto                    # auto | gemini | groq | openrouter | ollama | custom | off
# FRIDAY_FALLBACK_MODEL=                  # override the model (custom also needs FRIDAY_FALLBACK_URL + FRIDAY_FALLBACK_KEY)

# ---- voice ("Hey Friday"), set up with: friday-voice-setup
# (the "Hey Friday" wake word is toggled from Friday's footer and remembered; it's off by default)
# FRIDAY_SPEAK=off                        # don't read answers aloud
# FRIDAY_VOICE_MODEL=sonnet                # model for spoken conversations (fast); typed requests use FRIDAY_MODEL / your default
# FRIDAY_STT_MODEL=small.en               # tiny.en | base.en | small.en | medium.en | large-v3-turbo (bigger = more accurate, slower)
# FRIDAY_STT_DEVICE=auto                  # auto | cpu | cuda
# FRIDAY_TTS=auto                        # auto: natural neural voice online, Piper offline | piper: always local | neural
# FRIDAY_NEURAL_VOICE=en-US-AvaNeural     # e.g. en-US-EmmaNeural, en-GB-SoniaNeural, en-IN-NeerjaNeural (edge-tts --list-voices)
# FRIDAY_NEURAL_RATE=+4%                  # speaking speed of the neural voice
# FRIDAY_PIPER_VOICE=en_GB-jenny_dioco-medium   # offline voice, any from https://rhasspy.github.io/piper-samples (re-run setup after changing)
# FRIDAY_SILENCE_END=1.1                  # seconds of quiet that end what you're saying
# FRIDAY_VOCAB="Friday, Claude, Hyprland, your-project, ..."   # names and jargon Whisper should expect (your name is added for you)
# FRIDAY_VOICE_DEBUG=1                   # log every wake-word guess to .voice/voice.log
# FRIDAY_SPEECH_PACE=0.94                # Friday's speaking pace (lower = faster)
# FRIDAY_COMMA_HOLD=2                    # how long Friday breathes at commas (0 = Piper's own, 3-4 = more deliberate)
# FRIDAY_PAUSE_SENTENCE=0.34             # seconds of pause after each full stop
# FRIDAY_INPUT_TRUST=1                    # let Friday click and type without an approval card each time

# ---- on-device skills (time, timers, reminders, volume, apps, music, weather, maths… no Claude usage)
# FRIDAY_LOCAL=off                        # send everything to Claude instead
# FRIDAY_PHRASES=off                      # don't let Claude refresh the on-device phrasings (one small Haiku call a week)
# FRIDAY_PHRASES_MODEL=haiku

