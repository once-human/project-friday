#!/usr/bin/env python3
"""friday-local — Friday's on-device skills. No Claude, no plan usage, and most of them work offline.

    friday-local [--voice] [--in-chat] -- "what time is it"

Prints one JSON line:
    {"handled": true, "intent": "time", "text": "It's 9:41 pm.", "say": "It's 9 41 p.m.", "listen": false}
    {"handled": false}                      -> not a basic task: Friday hands it to Claude

Everyday things (time, date, timers, reminders, volume, brightness, media, music, apps, websites, search,
weather, battery, Wi-Fi, Bluetooth, system stats, screenshots, lock, workspaces, maths, unit conversion,
world clock, coin/dice, Claude usage, small talk, jokes) are done right here, instantly. Anything it isn't
sure about goes to Claude: a wrong guess is worse than a short wait.

If you're offline and it isn't a basic task, Friday says so (and what it can still do) instead of hanging.

Answers are phrased from a bank of variations so they don't sound canned. friday-phrases refreshes that bank
with Claude at most once a week (one small call), so it keeps sounding fresh without spending usage per answer.
"""
import ast
import datetime as dt
import json
import math
import operator
import os
import random
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
FH = os.environ.get("FRIDAY_HOME", os.path.join(HOME, ".local/share/friday"))
BIN = os.path.join(FH, "bin")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "friday")
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "friday")
BANK = os.path.join(STATE, "phrases.json")
os.environ["PATH"] = ":".join([BIN, HOME + "/.local/bin", "/usr/local/bin", "/usr/bin", os.environ.get("PATH", "")])



def load_config():
    """Pick up FRIDAY_* settings from config.env (Friday's other helpers source it as a shell file)."""
    try:
        with open(os.path.join(FH, "config.env")) as f:
            for line in f:
                m = re.match(r"\s*(?:export\s+)?(FRIDAY_[A-Z_]+)=(.*)", line)
                if m and m.group(1) not in os.environ:
                    os.environ[m.group(1)] = m.group(2).split(" #")[0].strip().strip("'\"")
    except OSError:
        pass


load_config()
ARGS = sys.argv[1:]
VOICE = "--voice" in ARGS
IN_CHAT = "--in-chat" in ARGS
RAW = ARGS[ARGS.index("--") + 1] if "--" in ARGS and ARGS.index("--") + 1 < len(ARGS) else (ARGS[-1] if ARGS else "")


# ---------------------------------------------------------------- helpers
def run(cmd, timeout=6):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout or "").strip()
    except Exception as e:
        return 1, str(e)


def spawn(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except Exception:
        return False


def have(x):
    return shutil.which(x) is not None


_online = None


def online():
    """Are we online? Saying "offline" wrongly would stop Friday reaching Claude, so this only says no when
    it's sure: NetworkManager reports no connectivity, or nothing at all can be reached."""
    global _online
    if _online is not None:
        return _online
    forced = os.environ.get("FRIDAY_ONLINE", "")
    if forced in ("1", "0"):
        _online = forced == "1"
        return _online
    if any(os.environ.get(v) for v in ("HTTPS_PROXY", "https_proxy", "ALL_PROXY", "all_proxy")):
        _online = True                            # behind a proxy we can't probe directly: assume yes
        return _online
    if have("nmcli"):
        code, out = run(["nmcli", "networking", "connectivity"], timeout=3)
        if code == 0 and out in ("full", "limited", "portal"):
            _online = True
            return _online
        if code == 0 and out == "none":
            _online = False
            return _online
    _online = False
    for host, port in (("api.anthropic.com", 443), ("1.1.1.1", 443), ("8.8.8.8", 53)):
        try:
            socket.create_connection((host, port), timeout=1.2).close()
            _online = True
            break
        except OSError:
            continue
    return _online


def now():
    return dt.datetime.now().astimezone()


def clock(t, spoken=False):
    h, m = t.hour % 12 or 12, t.minute
    ap = ("a.m." if t.hour < 12 else "p.m.") if spoken else ("am" if t.hour < 12 else "pm")
    if m == 0:
        return "%d %s" % (h, ap)
    if spoken and m < 10:
        return "%d oh %d %s" % (h, m, ap)
    return ("%d %d %s" if spoken else "%d:%02d %s") % (h, m, ap)


def plural(n, word):
    n = int(n) if float(n).is_integer() else n
    return "%s %s%s" % (n, word, "" if n == 1 else "s")


def human_duration(sec):
    sec = int(round(sec))
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    parts = []
    if h:
        parts.append(plural(h, "hour"))
    if m:
        parts.append(plural(m, "minute"))
    if s and not h:
        parts.append(plural(s, "second"))
    return " and ".join(parts) if parts else "a moment"


def part_of_day(t=None):
    h = (t or now()).hour
    return "morning" if 5 <= h < 12 else "afternoon" if h < 17 else "evening" if h < 22 else "night"


