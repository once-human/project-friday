# placeholders each intent may use, and the ones every phrasing must keep (bank lines that break this are dropped)
SLOTS = {k: set(re.findall(r"{(\w+)}", " ".join(v))) for k, v in P.items()}
CORE = {k: set.intersection(*[set(re.findall(r"{(\w+)}", x)) for x in v]) for k, v in P.items()}


def fits(intent, line):
    used = set(re.findall(r"{(\w+)}", line))
    return used <= SLOTS.get(intent, set()) and CORE.get(intent, set()) <= used


def load_bank():
    try:
        with open(BANK) as f:
            b = json.load(f).get("phrases", {})
        return {k: [x for x in v if isinstance(x, str) and fits(k, x)]
                for k, v in b.items() if k in P}
    except Exception:
        return {}


BANKED = None
LAST = os.path.join(STATE, "phrases-last.json")


def say(intent, **kw):
    """A phrasing for this intent that you didn't just hear."""
    global BANKED
    if BANKED is None:
        BANKED = load_bank()
    options = P[intent] + BANKED.get(intent, [])
    try:
        with open(LAST) as f:
            last = json.load(f)
    except Exception:
        last = {}
    recent = last.get(intent, [])
    fresh = [o for o in options if o not in recent] or options
    choice = random.choice(fresh)
    last[intent] = ([choice] + recent)[: max(1, min(3, len(options) - 1))]
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(LAST + ".tmp", "w") as f:
            json.dump(last, f)
        os.replace(LAST + ".tmp", LAST)
    except OSError:
        pass
    out = choice.format(**{k: v for k, v in kw.items()})
    return out[:1].upper() + out[1:] if out else out


def reply(intent, text, spoken=None, listen=False):
    spoken = re.sub(r"\.\.+", ".", spoken or text)
    text = re.sub(r"(?<!\.)\.\.(?!\.)", ".", text)
    print(json.dumps({"handled": True, "intent": intent, "text": text, "say": spoken, "listen": listen}))
    sys.exit(0)


def decline():
    print(json.dumps({"handled": False, "online": online()}))
    sys.exit(0)


# ---------------------------------------------------------------- understanding what you said
WORDNUM = {w: i for i, w in enumerate("zero one two three four five six seven eight nine ten eleven twelve thirteen "
                                       "fourteen fifteen sixteen seventeen eighteen nineteen twenty".split())}
WORDNUM.update({"thirty": 30, "forty": 40, "forty-five": 45, "fifty": 50, "sixty": 60, "ninety": 90, "hundred": 100,
                "a": 1, "an": 1, "a couple of": 2, "couple of": 2, "a few": 3, "few": 3})


def num(w):
    w = (w or "").strip().lower()
    if re.fullmatch(r"\d+(\.\d+)?", w):
        return float(w)
    return float(WORDNUM[w]) if w in WORDNUM else None


def clean(raw):
    t = raw.strip().lower().replace("’", "'").replace("`", "'")
    t = re.sub(r"^\W*((hey|hi|okay|ok|yo)\W+)?friday\b\W*", "", t)
    t = re.sub(r"[?!.…]+$", "", t).strip(" ,")
    for _ in range(2):
        t = re.sub(r"^(please|pls|can you|could you|would you|will you|can u|kindly|hey|okay|ok|so|um|uh|just)\b[\s,]*", "", t)
    t = re.sub(r"\s*\b(please|pls|for me|real quick|quickly)$", "", t).strip(" ,")
    return re.sub(r"\s+", " ", t)


DUR_RE = r"((?:\d+(?:\.\d+)?|an?|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|fifteen|twenty|thirty|forty|forty-five|fifty|sixty|ninety|a couple of|a few|half an?)\s*(?:and a half\s*)?(?:hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)(?:\s+and a half)?(?:\s*(?:and\s*)?(?:\d+|[a-z-]+)\s*(?:minutes?|mins?|m|seconds?|secs?|s))?)"


def parse_duration(s):
    """'5 minutes', 'an hour and a half', '1 hour 30 minutes', 'half an hour', '90 seconds' -> seconds."""
    s = (s or "").strip().lower()
    if re.fullmatch(r"half an? hour", s):
        return 1800
    if re.fullmatch(r"(a )?quarter (of )?an hour", s):
        return 900
    total, found = 0.0, False
    for n, unit, half in re.findall(r"(\d+(?:\.\d+)?|an?|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|"
                                    r"fifteen|twenty|thirty|forty|forty-five|fifty|sixty|ninety|a couple of|a few)\s*"
                                    r"(hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)\b(\s*and a half)?", s):
        v = num(n)
        if v is None:
            continue
        if half:
            v += 0.5
        mult = 3600 if unit.startswith("h") else 60 if unit.startswith("m") else 1
        total += v * mult
        found = True
    if re.search(r"(hours?|minutes?)\s+and a half", s) and not found:
        return None
    return int(total) if found and total > 0 else None


def parse_clock(s, base=None):
    """'6', '6 pm', '6:30', '6.30 pm', '18:30', 'noon', 'midnight' -> next datetime it happens."""
    base = base or now()
    s = s.strip().lower().replace(".", ":").replace("a:m:", "am").replace("p:m:", "pm")
    s = re.sub(r"\s*o'?clock", "", s)
    if s in ("noon", "midday"):
        h, m, ap = 12, 0, "pm"
    elif s == "midnight":
        h, m, ap = 0, 0, "am"
    else:
        mt = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?\s*(am|pm|in the morning|in the evening|at night|tonight)?", s)
        if not mt:
            return None
        h, m = int(mt.group(1)), int(mt.group(2) or 0)
        ap = mt.group(3) or ""
        if "morning" in ap:
            ap = "am"
        elif ap and ap != "am":
            ap = "pm"
        if h > 23 or m > 59:
            return None
    if ap == "am" and h == 12:
        h = 0
    elif ap == "pm" and h < 12:
        h += 12
    cands = []
    days = (0, 1, 2)
    hours = [h] if (ap or h > 12 or h == 0) else [h, (h + 12) % 24]
    for d in days:
        for hh in hours:
            c = (base + dt.timedelta(days=d)).replace(hour=hh, minute=m, second=0, microsecond=0)
            if c > base + dt.timedelta(seconds=20):
                cands.append(c)
    return min(cands) if cands else None


def when_words(t):
    today = now().date()
    if t.date() == today:
        return "at " + clock(t)
    if t.date() == today + dt.timedelta(days=1):
        return "tomorrow at " + clock(t)
    return "on %s at %s" % (t.strftime("%A"), clock(t))


def you_form(msg):
    m = " " + msg + " "
    for a, b in ((" my ", " your "), (" me ", " you "), (" i ", " you "), (" i'm ", " you're "), (" myself ", " yourself "),
                 (" mine ", " yours "), (" am ", " are ")):
        m = m.replace(a, b)
    return m.strip()


# ---------------------------------------------------------------- the skills
def k_time(t):
    if re.fullmatch(r"(what('s| is) the |what )?time( is it)?( now| right now)?|what time is it( now| right now)?|"
                    r"tell me the time|current time|time now|time please|got the time|do you know (what )?the time( is)?", t):
        n = now()
        late = 0 <= n.hour < 4
        intent = "time_late" if late and random.random() < 0.6 else "time"
        txt = say(intent, time=clock(n), part=part_of_day(n))
        return reply("time", txt, txt.replace(clock(n), clock(n, True)))
    m = re.fullmatch(r"(?:what(?:'s| is) the )?time(?: is it)? in ([a-z .'-]+)|what time is it in ([a-z .'-]+)", t)
    if m:
        city = (m.group(1) or m.group(2)).strip()
        tz = CITIES.get(city)
        if not tz:
            return None
        try:
            from zoneinfo import ZoneInfo
            ct = dt.datetime.now(ZoneInfo(tz))
        except Exception:
            return None
        diff = (ct.date() - now().date()).days
        cityday = "tomorrow there" if diff > 0 else "yesterday there" if diff < 0 else ct.strftime("%A")
        name = city.title() if len(city) > 3 else city.upper()
        txt = say("time_city", time=clock(ct), city=name, cityday=cityday)
        return reply("time_city", txt, txt.replace(clock(ct), clock(ct, True)))


