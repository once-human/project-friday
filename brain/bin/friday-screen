#!/usr/bin/env bash
# friday-screen [--window] — screenshot the focused monitor (or focused window); prints the image path.
# Friday can then Read the image to see what you see. The Friday overlay hides itself for the shot.
mkdir -p /tmp/friday
out="/tmp/friday/screen-$(date +%s).jpg"
qs -c friday ipc call friday cloak 900 >/dev/null 2>&1 && sleep 0.35
if [ "${1:-}" = "--window" ] && command -v hyprctl >/dev/null; then
  geo="$(hyprctl activewindow -j | python3 -c 'import json,sys;w=json.load(sys.stdin);print("%d,%d %dx%d"%(w["at"][0],w["at"][1],w["size"][0],w["size"][1]))' 2>/dev/null)"
  [ -n "$geo" ] && grim -t jpeg -q 85 -g "$geo" "$out" || grim -t jpeg -q 85 "$out"
else
  mon="$(hyprctl monitors -j 2>/dev/null | python3 -c 'import json,sys;print(next((m["name"] for m in json.load(sys.stdin) if m.get("focused")),""))' 2>/dev/null)"
  if [ -n "$mon" ]; then grim -t jpeg -q 85 -o "$mon" "$out"; else grim -t jpeg -q 85 "$out"; fi
fi
# remember how this image maps onto the real screen, so friday-input can click what Friday sees
python3 - "$out" "${1:-}" <<'PY' 2>/dev/null
import json, subprocess, sys, struct
out, mode = sys.argv[1], sys.argv[2]
def hj(*a):
    return json.loads(subprocess.run(["hyprctl", *a, "-j"], capture_output=True, text=True).stdout or "null")
def jpeg_size(path):
    with open(path, "rb") as f:
        d = f.read()
    i = 2
    while i < len(d):
        if d[i] != 0xFF: i += 1; continue
        m = d[i + 1]
        if m in (0xC0, 0xC1, 0xC2):
            h, w = struct.unpack(">HH", d[i + 5:i + 9]); return w, h
        i += 2 + struct.unpack(">H", d[i + 2:i + 4])[0]
    return None
iw, ih = jpeg_size(out) or (0, 0)
if mode == "--window":
    w = hj("activewindow"); ox, oy = w["at"]; lw, lh = w["size"]
else:
    m = next(m for m in hj("monitors") if m.get("focused"))
    ox, oy, sc = m["x"], m["y"], m.get("scale", 1) or 1
    lw, lh = round(m["width"] / sc), round(m["height"] / sc)
meta = {"image": out, "origin": [ox, oy], "logical": [lw, lh], "pixels": [iw, ih]}
for p in (out.rsplit(".", 1)[0] + ".json", "/tmp/friday/last-screen.json"):
    json.dump(meta, open(p, "w"))
PY
echo "$out"
