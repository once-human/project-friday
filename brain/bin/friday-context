#!/usr/bin/env python3
"""One JSON line describing 'right now' on this desktop. Fast, every probe is optional."""
import json, subprocess, os, glob, time, re, sys
sys.dont_write_bytecode = True
os.environ["PATH"] = os.path.expanduser("~/.local/bin") + ":/usr/local/bin:/usr/bin:" + os.environ.get("PATH", "")

def sh(cmd, t=1.2):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=t).stdout.strip()
    except Exception:
        return ""

out = {"time": time.strftime("%-I:%M %p"), "date": time.strftime("%a %d %b")}

try:
    j = json.loads(sh(["hyprctl", "activewindow", "-j"]) or "{}")
    out["win"] = {"class": j.get("class", ""), "title": j.get("title", ""), "ws": (j.get("workspace") or {}).get("id")}
except Exception:
    out["win"] = {}

st = sh(["playerctl", "status"])
if st:
    out["media"] = {"status": st, "title": sh(["playerctl", "metadata", "title"]), "artist": sh(["playerctl", "metadata", "artist"])}

v = sh(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
m = re.search(r"([0-9.]+)", v)
if m:
    out["vol"] = {"pct": round(float(m.group(1)) * 100), "muted": "MUTED" in v}

parts = sh(["brightnessctl", "-m"]).split(",")
if len(parts) >= 4:
    try:
        out["bright"] = int(parts[3].strip().rstrip("%"))
    except ValueError:
        pass

for p in glob.glob("/sys/class/power_supply/BAT*"):
    try:
        out["bat"] = {"pct": int(open(p + "/capacity").read()), "status": open(p + "/status").read().strip()}
        break
    except Exception:
        pass

for line in sh(["nmcli", "-t", "-f", "ACTIVE,SSID", "dev", "wifi"]).splitlines():
    if line.startswith("yes:"):
        out["net"] = line[4:]
        break

try:
    mi = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo")}
    out["mem"] = {"used_gb": round((mi["MemTotal"] - mi["MemAvailable"]) / 1048576, 1), "total_gb": round(mi["MemTotal"] / 1048576, 1)}
    out["load"] = round(os.getloadavg()[0], 2)
except Exception:
    pass

# clipboard, as a short local preview only (never sent anywhere unless you ask Friday about it)
types = sh(["wl-paste", "--list-types"], 0.6)
if "image/" in types:
    out["clip"] = {"kind": "image", "preview": "An image"}
elif types:
    t = sh(["wl-paste", "--no-newline", "--type", "text"], 0.6)[:400]
    t = " ".join(t.split())
    if t and not re.fullmatch(r"[A-Za-z0-9_\-.+/=]{24,}", t):     # looks like a token/password: don't surface it
        out["clip"] = {"kind": "text", "preview": t[:140]}

print(json.dumps(out))
