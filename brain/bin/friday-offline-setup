#!/usr/bin/env bash
# friday-offline-setup — give Friday an offline brain: Ollama + a free open model, your pick.
#   After this, Friday keeps answering with no internet, no Claude usage and no limits. Nothing leaves the laptop.
#   friday-offline-setup                 show the sizes, recommend one for this laptop, let you pick
#   friday-offline-setup --model TIER    small | balanced | smart | smartest | any Ollama model name (e.g. gemma3:4b)
#   friday-offline-setup --yes           no questions: the recommended size, capped at "balanced" (2.5 GB)
#   friday-offline-setup --models        just print the sizes and which one suits this laptop
set -o pipefail
FH="${FRIDAY_HOME:-$HOME/.local/share/friday}"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"
YES=0; MODEL=""; INSTALL=1; LIST=0
while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes) YES=1 ;; --model) MODEL="$2"; shift ;; --model=*) MODEL="${1#--model=}" ;;
    --no-install) INSTALL=0 ;; --models|--list) LIST=1 ;;
  esac; shift
done
say()  { printf '\033[1;38;5;173m▸\033[0m %s\n' "$*"; }
note() { printf '  \033[2m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }
ask()  { [ "$YES" = 1 ] && return 0; local a; read -r -p "$1 [Y/n] " a </dev/tty || return 0; [[ ! "$a" =~ ^[Nn] ]]; }
HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}"; [[ "$HOST" == http* ]] || HOST="http://$HOST"
up() { curl -fsS --max-time 2 "$HOST/api/tags" >/dev/null 2>&1; }

# ---- 1. pick a model (Qwen3: Apache-2.0, small sizes, can use tools). You choose; we recommend.
RAM_GB=$(awk '/MemTotal/ {printf "%d", $2/1048576}' /proc/meminfo)
VRAM_GB=0
command -v nvidia-smi >/dev/null && VRAM_GB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | awk '{printf "%d", $1/1024}')
TIERS=(small balanced smart smartest)
declare -A TAG=([small]=qwen3:1.7b [balanced]=qwen3:4b [smart]=qwen3:8b [smartest]=qwen3:14b)
declare -A SIZE=([small]="1.4 GB" [balanced]="2.5 GB" [smart]="5.2 GB" [smartest]="9.3 GB")
declare -A NEEDS=([small]="any laptop" [balanced]="8 GB RAM" [smart]="a 6 GB GPU (or 16 GB RAM, slow)" [smartest]="a 12 GB GPU (or 32 GB RAM, slow)")
declare -A WHAT=([small]="quick answers, basic tasks; fast even on old CPUs" [balanced]="good everyday helper"
                 [smart]="noticeably smarter, slower without a GPU" [smartest]="best quality, needs a strong machine")
# Without a GPU every reply runs on your CPU, so the recommendation stays light: a bigger model is smarter but
# makes the laptop work much harder for every answer. With a decent GPU the bigger ones are cheap.
if   [ "$VRAM_GB" -ge 12 ]; then REC=smartest
elif [ "$VRAM_GB" -ge 6 ];  then REC=smart
elif [ "$RAM_GB" -ge 7 ];   then REC=balanced
else REC=small; fi

show_tiers() {
  echo "Offline brain sizes (this laptop: ${RAM_GB} GB RAM$([ "$VRAM_GB" -gt 0 ] && echo ", ${VRAM_GB} GB GPU")):"
  local i=1 t
  for t in "${TIERS[@]}"; do
    printf '  %d) %-9s %-11s %-7s needs %-24s %s%s\n' "$i" "$t" "${TAG[$t]}" "${SIZE[$t]}" "${NEEDS[$t]}" "${WHAT[$t]}" \
      "$([ "$t" = "$REC" ] && echo "   ← recommended")"
    i=$((i + 1))
  done
}
[ "$LIST" = 1 ] && { show_tiers; echo "Any other Ollama model works too: --model gemma3:4b (see https://ollama.com/library)"; exit 0; }

if [ -z "$MODEL" ]; then
  if [ "$YES" = 1 ]; then
    MODEL=$REC; [ "$MODEL" = smart ] || [ "$MODEL" = smartest ] && MODEL=balanced   # never several GB unasked
  else
    show_tiers
    echo "  5) skip for now (set it up later: project-friday offline setup)"
    def=1; for i in 1 2 3 4; do [ "${TIERS[$((i-1))]}" = "$REC" ] && def=$i; done
    read -r -p "Pick 1-5 [$def]: " pick </dev/tty || pick=""
    pick="${pick:-$def}"
    case "$pick" in
      [1-4]) MODEL="${TIERS[$((pick-1))]}" ;;
      *) echo "Skipped. Friday still works; when you want it: project-friday offline setup"; exit 0 ;;
    esac
  fi
fi
if [ -n "${TAG[$MODEL]:-}" ]; then T="$MODEL"; MODEL="${TAG[$T]}"; SZ="${SIZE[$T]}"; else SZ="?"; fi
say "Offline brain: $MODEL (~$SZ download)"
note "Runs entirely on this laptop through Ollama: free forever, no account, no internet needed once it's downloaded."
note "A small model is great for everyday questions and quick tasks, not a replacement for Claude on big jobs."

# ---- 2. Ollama
if ! command -v ollama >/dev/null; then
  [ "$INSTALL" = 1 ] || { warn "Ollama isn't installed (skipped: --no-deps). Install it, then run: project-friday offline setup"; exit 0; }
  ask "Install Ollama (needs sudo once)?" || { echo "Skipped. Run 'project-friday offline setup' any time."; exit 0; }
  if command -v pacman >/dev/null; then
    pkg=ollama
    command -v nvidia-smi >/dev/null && pkg=ollama-cuda
    lspci 2>/dev/null | grep -qiE 'vga.*(amd|ati)|display.*(amd|ati)' && ! command -v nvidia-smi >/dev/null && pkg=ollama-rocm
    say "installing $pkg from the Arch repos"
    sudo pacman -S --needed --noconfirm "$pkg" || { warn "pacman failed"; exit 1; }
  else
    say "installing Ollama with its official installer (https://ollama.com/install.sh)"
    curl -fsSL https://ollama.com/install.sh | sh || { warn "Ollama install failed; see https://ollama.com/download"; exit 1; }
  fi
fi

# ---- 3. its server (Friday also starts it on demand, so no service is required)
STARTED=""
if ! up; then
  RT="${XDG_RUNTIME_DIR:-/tmp/friday-$(id -u)}/friday"; (umask 077; mkdir -p "$RT")
  ollama serve >>"$RT/ollama.log" 2>&1 &
  STARTED=$!
  for _ in $(seq 1 40); do sleep 0.25; up && break; done
  up || { warn "Ollama's server didn't start (log: $RT/ollama.log)"; exit 1; }
fi
# Friday starts Ollama only when it needs it and stops it again when idle, so stop the one we started here
trap '[ -n "$STARTED" ] && kill "$STARTED" 2>/dev/null' EXIT
if systemctl is-enabled ollama.service >/dev/null 2>&1; then
  note "Ollama's system service runs all the time; Friday doesn't need it (it starts Ollama on demand)."
  note "To free those resources when Friday isn't thinking: sudo systemctl disable --now ollama"
fi

# ---- 4. the model
if curl -fsS "$HOST/api/tags" | grep -q "\"$MODEL\""; then
  say "$MODEL is already downloaded"
else
  ask "Download $MODEL (~$SZ)?" || { echo "Skipped."; exit 0; }
  ollama pull "$MODEL" || { warn "download failed"; exit 1; }
fi

# ---- 5. remember the choice (config.env is yours; Friday's guard never lets Claude write it)
CFG="$FH/config.env"; [ -f "$CFG" ] || cp "$FH/config.example.env" "$CFG"
python3 - "$CFG" "$MODEL" <<'PY'
import re, sys
p, m = sys.argv[1], sys.argv[2]
s = open(p).read()
line = "FRIDAY_LOCAL_MODEL=%s" % m
s = re.sub(r"(?m)^FRIDAY_LOCAL_MODEL=.*$", line, s) if re.search(r"(?m)^FRIDAY_LOCAL_MODEL=", s) else s.rstrip("\n") + "\n\n# offline brain (project-friday offline setup)\n" + line + "\n"
open(p, "w").write(s)
PY

# ---- 6. say hi
say "testing it…"
reply=$(curl -fsS --max-time 180 "$HOST/api/chat" -d "{\"model\":\"$MODEL\",\"stream\":false,\"think\":false,\"keep_alive\":0,\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: ready\"}]}" 2>/dev/null \
  | python3 -c 'import json,sys; print(json.load(sys.stdin)["message"]["content"].strip()[:60])' 2>/dev/null)
if [ -n "$reply" ]; then say "Offline brain ready ($MODEL said: $reply). Friday now answers even with no internet or Claude limit."
else warn "Installed, but the test didn't answer in time (the first load can be slow). Try: project-friday offline test"; fi
