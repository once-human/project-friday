#!/usr/bin/env bash
# friday-open <app name> — launch an installed desktop app by (fuzzy) name.
q="$*"; [ -z "$q" ] && { echo "usage: friday-open <app name>"; exit 2; }
dirs=("$HOME/.local/share/applications" /usr/share/applications /var/lib/flatpak/exports/share/applications "$HOME/.local/share/flatpak/exports/share/applications")
# match the name literally (your words are never treated as a pattern or an option)
f=""
for d in "${dirs[@]}"; do
  for df in "$d"/*.desktop; do
    [ -f "$df" ] || continue
    if grep -i -m1 -E '^Name(\[[^]]*\])?=' "$df" | cut -d= -f2- | grep -qiF -- "$q"; then f="$df"; break 2; fi
  done
done
[ -z "$f" ] && f="$(ls -1 "${dirs[@]}" 2>/dev/null | grep '\.desktop$' | grep -iF -- "$q" | head -1)"
[ -z "$f" ] && { echo "no installed app matches: $q"; exit 1; }
id="$(basename "$f" .desktop)"
setsid -f gtk-launch "$id" >/dev/null 2>&1 && echo "launched $id"
