#!/usr/bin/env python3
"""Friday permission policy — a Claude Code PreToolUse hook.

Every tool call Friday wants to make passes through here and gets one of:
  allow  read-only inspection and small reversible actions: runs silently
  ask    anything that changes state: the Friday overlay shows an approval card
  deny   credentials, privilege escalation, disk-destroying commands: refused outright
Every decision is appended to ~/.local/share/friday/audit.log.
"""
import json, os, re, shlex, subprocess, sys, time, uuid

HOME = os.path.expanduser("~")
JH = os.environ.get("FRIDAY_HOME", os.path.join(HOME, ".local/share/friday"))
RT = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp/friday-%d" % os.getuid(), "friday")
AUDIT = os.path.join(JH, "audit.log")
# Where Friday may write freely: its own notes, and a private scratch folder. Nothing else.
SCRATCH = os.path.join(RT, "scratch")
MEMORY = os.path.join(JH, "memory")
APPROVAL_TIMEOUT = 120
RANK = {"allow": 0, "ask": 1, "deny": 2}
RISK = {"low": 0, "medium": 1, "high": 2}

# ------------------------------------------------------------------ helpers
def audit(decision, tool, summary, reason):
    # never keep what Friday was told to type (could be a password)
    summary = re.sub(r"(friday-input\s+type\s+).*", lambda m: m.group(1) + "[%d chars typed]" % len(summary), summary)
    try:
        fd = os.open(AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps({"t": time.strftime("%Y-%m-%d %H:%M:%S"), "decision": decision,
                                "tool": tool, "what": summary[:300], "why": reason}) + "\n")
    except Exception:
        pass

def emit(decision, reason, tool="", summary=""):
    audit(decision, tool, summary, reason)
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                              "permissionDecision": decision,
                                              "permissionDecisionReason": reason}}))
    sys.exit(0)

def rp(p):
    p = os.path.expandvars(os.path.expanduser(str(p)))
    return os.path.realpath(p)

def under(p, *roots):
    p = rp(p)
    return any(p == r or p.startswith(r.rstrip("/") + "/") for r in map(os.path.realpath, roots))

SAFE_WRITE_ROOTS = (SCRATCH, MEMORY)

# Friday's own machinery. A web page that talks Claude into editing these could switch the guard off or run code at
# next login, so changes are refused outright (edit them yourself in a terminal).
def _repo_root():
    real = os.path.realpath(JH)
    parent = os.path.dirname(real)
    return parent if os.path.basename(real) == "brain" and os.path.isdir(os.path.join(parent, "shell")) else None
REPO = _repo_root()
# Never writable by Claude: the guard itself, what wires it in, Friday's keys, Claude Code's own settings, and git
# internals (hooks/config there run code). Changing these is how a prompt injection would switch the guard off.
PROTECTED = [os.path.join(JH, x) for x in ("bin/friday-approve", "bin/friday-ask", "bin/friday-fallback", ".claude", "config.env")]
PROTECTED += [os.path.join(HOME, ".claude"), os.path.join(HOME, ".claude.json")]
if REPO:
    PROTECTED += [os.path.join(REPO, ".git")]
def protected(p):
    return bool(p) and under(p, *PROTECTED)

# The rest of Friday's own code: you can have Friday work on itself, but every change shows you the diff, as high risk.
SELF = [os.path.join(JH, x) for x in ("bin", "voice", "CLAUDE.md", "integration")]
SELF += [os.path.join(HOME, ".config", "quickshell", "friday")]
if REPO:
    SELF += [os.path.join(REPO, x) for x in ("shell", "hypr", "desktop", "install.sh", "uninstall.sh", "docs", "README.md",
                                              "SECURITY.md", "LICENSE")]
def self_code(p):
    return bool(p) and under(p, *SELF)

# Things that run when you log in or open a shell: changing them is how malware persists, so they always ask, loudly.
STARTUP = [os.path.join(HOME, x) for x in (".bashrc", ".bash_profile", ".profile", ".zshrc", ".zprofile", ".zshenv",
           ".xinitrc", ".xprofile", ".config/fish", ".config/autostart", ".config/systemd", ".config/hypr", ".config/sway",
           ".config/niri", ".config/river", ".config/labwc", ".config/environment.d", ".pam_environment",
           ".local/share/applications", ".local/bin", ".config/quickshell")]
def startup(p):
    return bool(p) and under(p, *STARTUP)

SENSITIVE = [re.compile(x, re.I) for x in (
    r"/\.ssh(/|$)", r"/\.gnupg(/|$)", r"/\.claude/\.credentials", r"/\.claude\.json$",
    r"/\.config/(google-chrome|chromium|BraveSoftware|vivaldi|microsoft-edge|zen|discord|Claude|1Password|Bitwarden)(/|$)",
    r"/\.(mozilla|zen|librewolf)(/|$)", r"/\.local/share/keyrings", r"/\.local/share/kwalletd",
    r"(^|/)(Login Data|Cookies|Web Data|logins\.json|key[34]\.db|cookies\.sqlite)$",
    r"/etc/(shadow|gshadow|sudoers)", r"\.kdbx?$", r"(^|/)id_(rsa|ed25519|ecdsa|dsa)(\.|$)",
    r"/\.aws/credentials", r"/\.netrc$", r"/\.config/gh/hosts\.yml$", r"/\.docker/config\.json$",
    r"/\.npmrc$", r"/\.pypirc$", r"/\.config/rclone/", r"/\.git-credentials$",
    # more places tokens and private messages live
    r"/\.(bash|zsh|python|psql|mysql|node_repl|sqlite)_history$", r"/\.local/share/fish/fish_history$", r"/\.histfile$",
    r"/\.kube/config$", r"/\.config/gcloud(/|$)", r"/\.azure(/|$)", r"/\.password-store(/|$)", r"/\.config/op(/|$)",
    r"/\.config/Signal(/|$)", r"/\.local/share/TelegramDesktop(/|$)", r"/\.config/(Slack|discord|Element|whatsapp|WhatsApp)(/|$)",
    r"/\.config/Code/User/globalStorage(/|$)", r"/\.config/Cursor/User/globalStorage(/|$)", r"/\.var/app/[^/]+/(config|data)/",
    r"/\.thunderbird(/|$)", r"/\.local/share/(gnome-online-accounts|evolution)(/|$)", r"/\.config/(hub|glab-cli)(/|$)",
    r"/\.terraform\.d/credentials", r"/\.config/doctl", r"/\.netlify", r"/\.vercel(/|$)", r"/\.config/stripe",
)]
def sensitive(s):
    s = os.path.expanduser(str(s))
    return any(r.search(s) for r in SENSITIVE)

def worst(a, b):
    """combine two (decision, reason, risk) tuples, keeping the stricter one"""
    if RANK[b[0]] > RANK[a[0]]: return b
    if RANK[b[0]] == RANK[a[0]] and RISK[b[2]] > RISK[a[2]]: return b
    return a

A = lambda why="read-only": ("allow", why, "low")
Q = lambda why, risk="medium": ("ask", why, risk)
D = lambda why: ("deny", why, "high")

# ------------------------------------------------------------------ bash policy
PURE_RO = set("""ls cat head tail wc du df free uptime uname date whoami id hostname hostnamectl lsblk lscpu lspci
lsusb lsmod sensors nproc echo printf pwd which whereis type file stat tree basename dirname realpath
readlink sort uniq cut tr grep egrep fgrep fd fdfind jq column nl tac diff cmp md5sum sha1sum sha256sum
sleep true false test [ wl-paste fc-list ps pgrep pidof ss findmnt blkid timedatectl localectl loginctl
xxd od strings cd unset read dmesg lsns numfmt expr seq rev fold paste comm join
fastfetch neofetch grim slurp notify-send playerctl journalctl""".split())
# Friday's own helpers that are safe to run without asking (anything else in bin/ asks). Matched by real path,
# so a file that merely has the same name somewhere else is NOT trusted.
HELPERS_FREE = {"friday-context", "friday-screen", "friday-windows", "friday-open", "friday-remind", "friday-focus",
                "friday-music", "friday-sessions", "friday-continue", "friday-voice", "friday-do", "friday-usage",
                "friday-notify", "friday-profile", "friday-wm", "friday-local", "friday-toggle", "friday-login"}
HELPERS_ASK = {"friday-integrate": "re-patches illogical-impulse", "friday-phrases": "uses a little Claude usage",
               "friday-offline-setup": "installs Ollama and downloads a local model (several GB)",
               "friday-voice-setup": "downloads ~700 MB of speech models", "friday-start": "restarts or stops Friday"}
DENY_PROGS = {"sudo", "doas", "su", "pkexec", "run0"}
DISK_DESTROY = {"dd", "mkfs", "fdisk", "sfdisk", "gdisk", "parted", "wipefs", "shred", "cryptsetup",
                "mkswap", "blkdiscard", "mkfs.ext4", "mkfs.btrfs", "mkfs.vfat", "mkfs.xfs", "mkfs.fat"}
POWER = {"reboot", "shutdown", "poweroff", "halt"}
SHELLS = {"sh", "bash", "zsh", "fish", "dash", "python", "python3", "node", "perl", "ruby", "php", "lua"}
WRITERS = {"mkdir", "touch", "cp", "mv", "rm", "ln", "chmod", "chown", "truncate", "install", "rsync",
           "tar", "unzip", "zip", "7z", "tee", "rmdir", "mktemp"}
HYPR_READ = {"clients", "monitors", "workspaces", "activewindow", "activeworkspace", "devices", "version",
             "binds", "layers", "getoption", "splash", "cursorpos", "animations", "globalshortcuts",
             "layouts", "configerrors", "descriptions", "rollinglog", "systeminfo", "notify", "workspacerules", "-j"}
HYPR_DISPATCH_SAFE = {"workspace", "focuswindow", "togglefloating", "fullscreen", "fullscreenstate", "movefocus",
                      "cyclenext", "togglespecialworkspace", "movetoworkspace", "movetoworkspacesilent",
                      "pin", "centerwindow", "resizeactive", "moveactive", "focusmonitor", "swapnext",
                      "togglesplit", "focuscurrentorlast", "focusworkspaceoncurrentmonitor", "bringactivetotop"}

def rm_target_is_catastrophic(args):
    for a in args:
        if a.startswith("-"): continue
        p = os.path.expandvars(os.path.expanduser(a))
        if a in ("/", "/*", "~", "~/", "$HOME", "*", ".", "..") or p.rstrip("/") in ("", HOME) or p in ("/*", HOME + "/*"):
            return True
        if os.path.realpath(p).count("/") <= 1 and os.path.realpath(p) not in ("/tmp",):
            return True
    return False

def writer_policy(prog, args):
    paths = [a for a in args if not a.startswith("-") and not re.fullmatch(r"\d+(\.\d+)?|[ugoa]*[+-=][rwxXst]+|[0-7]{3,4}|[\w.-]+:[\w.-]+", a)]
    flags = "".join(a for a in args if a.startswith("-"))
    if prog in ("rm", "rmdir") and ("r" in flags or "R" in flags or "f" in flags or "recursive" in flags) and rm_target_is_catastrophic(args):
        return D("refusing a recursive/forced delete of a top-level or home path")
    if prog in ("chmod", "chown") and ("R" in flags) and any(a in ("/", "~", HOME, "/*") for a in paths):
        return D("refusing recursive permission change on / or home")
    if prog == "tar" and args and re.fullmatch(r"-?t\w*|--list", args[0]):
        return A("lists an archive")
    if prog == "unzip" and "-l" in args:
        return A("lists an archive")
    if any(protected(p) for p in paths):
        return D("that's Friday's guard, its settings or its keys: change it yourself in a terminal")
    if any(self_code(p) for p in paths):
        return Q(f"{prog} changes Friday's own code", "high")
    if any(startup(p) for p in paths):
        return Q(f"{prog} changes something that runs at login or in every shell", "high")
    if prog in ("tar", "unzip", "zip", "7z", "rsync", "cp", "mv", "install", "ln") and not paths:
        return Q(f"{prog} writes into the current folder")
    if prog == "mktemp": return A("temp file")
    if paths and all(under(p, *SAFE_WRITE_ROOTS) for p in paths):
        return A("scratch space only")
    risk = "high" if prog in ("rm", "rmdir", "truncate", "shred") or ("r" in flags and prog == "rm") else "medium"
    return Q(f"{prog} changes files outside scratch space", risk)

def split_segments(cmd):
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    lex.commenters = ""
    toks = list(lex)
    segs, cur = [], []
    for t in toks:
        if t in (";", "&&", "||", "|", "&", "|&"):
            if cur: segs.append((cur, t))
            cur = []
        else:
            cur.append(t)
    if cur: segs.append((cur, None))
    return segs

REDIR = re.compile(r"^[0-9]*(>>?|<<?<?|>&|<&|&>>?|>\|)$")

def policy_segment(toks, followed_by_pipe_from_fetch):
    # strip redirects (judge their targets) and env assignments / wrappers
    out, redirect_verdict, i = [], A(), 0
    while i < len(toks):
        t = toks[i]
        if t in ("(", ")", "((", "))", "<(", ">("):
            return Q("subshell / process substitution")
        if REDIR.match(t):
            op = t
            tgt = toks[i + 1] if i + 1 < len(toks) else ""
            i += 2
            if op.endswith("<<") or op.endswith("<<<") or op == "<<<":
                return Q("heredoc / here-string")
            if op.startswith("<"):
                if sensitive(tgt): return D("reads a credential/browser-data path")
                continue
            if re.fullmatch(r"&?\d+|-", tgt) and op.endswith("&"): continue
            if tgt == "/dev/null" or under(tgt, *SAFE_WRITE_ROOTS): continue
            if protected(tgt): return D("writes into Friday's guard, settings or keys")
            if self_code(tgt):
                redirect_verdict = worst(redirect_verdict, Q("writes into Friday's own code", "high"))
                continue
            if startup(tgt):
                redirect_verdict = worst(redirect_verdict, Q("writes into something that runs at login or in every shell", "high"))
                continue
            if tgt.startswith("/dev/sd") or tgt.startswith("/dev/nvme") or tgt.startswith("/dev/mmcblk"):
                return D("redirect onto a block device")
            redirect_verdict = worst(redirect_verdict, Q("redirects output into a file outside scratch space"))
            continue
        out.append(t); i += 1
    toks = out
    while toks and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0]):
        if re.match(r"^(LD_\w+|PATH|PYTHON\w*|PERL\w*|RUBY\w*|NODE_OPTIONS|BASH_ENV|ENV|PROMPT_COMMAND|GIT_\w+|PAGER|EDITOR|VISUAL|LESSOPEN|MANPAGER|SHELL|HOME|XDG_CONFIG_HOME|FRIDAY_\w+)=", toks[0]):
            return Q("sets an environment variable that changes what code runs: " + toks[0].split("=")[0])
        toks = toks[1:]
    while toks and os.path.basename(toks[0]) in ("env", "command", "nice", "ionice", "time", "nohup", "setsid", "stdbuf", "timeout", "builtin"):
        w = os.path.basename(toks[0]); toks = toks[1:]
        if w == "env" and not [x for x in toks if not x.startswith("-")]:
            return Q("prints all environment variables (may include secrets)", "low")
        while toks and (toks[0].startswith("-") or (w == "timeout" and re.fullmatch(r"[\d.]+[smhd]?", toks[0])) or re.match(r"^[A-Za-z_]\w*=", toks[0])): toks = toks[1:]
    if not toks: return redirect_verdict
    prog, args = os.path.basename(toks[0]), toks[1:]
    joined = " ".join(args)

    if any(sensitive(x) for x in [prog] + args):
        return D("touches credentials / browser data / key material")
    if prog in DENY_PROGS: return D(f"{prog}: privilege escalation can't be approved from here. Give the user the exact command to run in a terminal instead")
    if prog in DISK_DESTROY or prog.startswith("mkfs"): return D(f"{prog} can destroy disks")
    if prog in POWER: return Q(f"{prog} will end your session", "high")
    if followed_by_pipe_from_fetch and prog in SHELLS: return D("piping a download straight into a shell")
    if prog in WRITERS: return worst(redirect_verdict, writer_policy(prog, args))
    # anything that isn't a plain reader and names the guard, its settings or keys (sed -i, perl -pi, python, tee…)
    if prog not in PURE_RO and any(protected(a.split("=", 1)[-1]) for a in args if a.split("=", 1)[-1].startswith(("/", "~", "."))):
        return D("that would touch Friday's guard, its settings or its keys: change it yourself in a terminal")
    helper = trusted_helper(toks[0])
    if helper:
        prog = helper
        if prog == "project-friday":
            sub = args[0] if args else "help"
            if sub in ("status", "version", "help", "-h", "--help", "logs", "log", "usage", "music", "play", "open", "show",
                       "close", "hide") or (sub in ("offline", "backup", "fallback") and args[1:2] in ([], ["status"])):
                return redirect_verdict
            return worst(redirect_verdict, Q("project-friday %s changes Friday itself" % sub,
                                             "high" if sub in ("update", "upgrade", "uninstall") else "medium"))
        if prog in HELPERS_ASK:
            return worst(redirect_verdict, Q(f"{prog} {HELPERS_ASK[prog]}", "low"))
        if prog == "friday-web":
            sub = args[0] if args else ""
            url = args[1] if len(args) > 1 else ""
            if sub == "open" and not re.match(r"^https?://", url):
                return Q("opens something that isn't a web page: " + url[:100], "medium")
            return redirect_verdict
        if prog == "friday-clip":
            return redirect_verdict if (args[:1] in (["get"], ["types"], ["image"]) or not args) else Q("changes your clipboard", "low")
        if prog == "friday-input":
            # Driving your mouse/keyboard. Looking (move, scroll, screen info) is fine; clicking and typing ask,
            # unless you've said you trust it (FRIDAY_INPUT_TRUST=1 in config.env).
            sub = args[0] if args else ""
            if sub in ("move", "scroll", "where", "info") or os.environ.get("FRIDAY_INPUT_TRUST") == "1":
                return redirect_verdict
            what = " ".join(args)[:80]
            return Q("will %s on your screen: %s" % ("type" if sub in ("type", "key") else "click", what))
        if prog in HELPERS_FREE:
            return redirect_verdict
        return worst(redirect_verdict, Q(f"{prog} isn't on the auto-approve list"))
    if prog.startswith("friday-"):
        return Q(f"{toks[0]} isn't Friday's own copy of {prog}", "high")
    # --- per-program rules ---
    v = None
    if prog in PURE_RO: v = A()
    elif prog == "sed":
        script = " ".join(a for a in args if not a.startswith("-"))
        risky = (any(a == "-i" or a.startswith("-i") or a == "--in-place" for a in args)
                 or re.search(r"(^|[;{}\s'\"])\d*\$?\s*[eRrWw](\s|$|')", script) or re.search(r"/[gIpm0-9]*[ew]", script))
        v = Q("sed that edits files or runs commands") if risky else A()
    elif prog == "awk" or prog == "gawk":
        prog_text = " ".join(args)
        v = Q("awk that can run commands or write files") if re.search(r"system|\||>|getline|ENVIRON|fflush|close\(", prog_text) else A()
    elif prog == "rg":
        v = Q("ripgrep running a preprocessor") if any(a.startswith("--pre") for a in args) else A()
    elif prog == "find":
        v = Q("find with an action (-exec/-delete/-fprint)") if any(a in ("-exec", "-execdir", "-ok", "-okdir", "-delete", "-fls") or a.startswith("-fprint") for a in args) else A()
    elif prog in ("curl", "wget"):
        # Fetching is fine for well-known read-only hosts; anything else could carry your data out in the URL.
        url = next((a for a in args if re.match(r"^https?://", a)), "")
        host = re.sub(r"^https?://([^/:?#]+).*", r"\1", url).lower()
        bad = {"-o", "-O", "-d", "-F", "-T", "-K", "-X", "--output", "--data", "--data-raw", "--data-binary", "--form", "--upload-file", "-P", "--post-data", "--post-file", "--config", "-H", "--header", "-b", "--cookie"}
        if any(a in bad or a.startswith(("--data", "--output", "-o", "-O", "-H", "--header")) for a in args):
            v = Q("download/upload with curl/wget")
        elif host and any(host == h or host.endswith("." + h) for h in FETCH_OK) and len(url) < 200:
            v = A("read-only fetch from a well-known site")
        else:
            v = Q("sends a web request to " + (host or "somewhere"), "low")
    elif prog == "ip":
        v = Q("changes network config") if re.search(r"\b(add|del|delete|set|flush|change|replace)\b", joined) else A()
    elif prog == "nmcli":
        ok = re.fullmatch(r"(-\S+\s+)*(general( status)?|radio( all)?|device( status| show.*| wifi list.*)?|connection( show.*)?|networking connectivity)?\s*", joined)
        v = A() if ok else Q("changes network state")
    elif prog == "bluetoothctl":
        v = A() if args and args[0] in ("show", "devices", "info", "paired-devices") else Q("bluetooth action")
    elif prog == "pactl":
        v = A() if args and (args[0] in ("list", "info", "stat") or args[0].startswith(("get-", "set-sink-volume", "set-sink-mute", "set-source-volume", "set-source-mute"))) else Q("audio config change", "low")
    elif prog == "wpctl":
        v = A() if args and args[0] in ("status", "inspect", "get-volume", "set-volume", "set-mute") else Q("audio routing change", "low")
    elif prog == "brightnessctl":
        v = A() if (not args or args[0] in ("get", "info", "max", "set", "-s", "-r", "s", "-d", "--device", "-l", "i", "g", "m")) else Q("brightness", "low")
    elif prog == "systemctl":
        sub = [a for a in args if not a.startswith("-")]
        v = A() if sub and sub[0] in ("status", "is-active", "is-enabled", "is-failed", "list-units", "list-unit-files", "list-timers", "show", "cat", "list-dependencies", "list-sockets") else Q("changes a service")
    elif prog in ("pacman", "paru", "yay"):
        v = A() if args and re.fullmatch(r"-(Q\w*|Si|Ss|Sl|Sii|F\w*|T|Qi|Ql)|--query|--search", args[0]) else Q("package change (installs/removals)")
    elif prog == "flatpak":
        v = A() if args and args[0] in ("list", "info", "search", "remotes", "remote-ls") else Q("flatpak change")
    elif prog == "git" and any(a in ("-c", "--config-env", "--exec-path") or a.startswith(("--config-env", "--exec-path", "-c")) for a in args):
        v = Q("git with inline config can run programs")
    elif prog == "git":
        a2 = list(args)
        while a2 and (a2[0].startswith("-") or a2[0] in ()):
            if a2[0] in ("-C", "-c"): a2 = a2[2:]
            else: a2 = a2[1:]
        sub = a2[0] if a2 else ""
        rest = " ".join(a2[1:])
        if sub in ("status", "log", "diff", "show", "rev-parse", "ls-files", "blame", "describe", "shortlog", "reflog", "grep", "ls-remote", "rev-list", "cat-file", "check-ignore", "whatchanged", "ls-tree", "name-rev", "var", "count-objects"):
            v = A()
        elif sub in ("branch", "tag", "remote", "stash", "config") and not re.search(r"(^| )(-d|-D|-m|-M|add|remove|rm|set-url|rename|prune|drop|pop|apply|push|clear|--unset|--add|--global|--system)\b", rest) and (sub != "config" or "--get" in rest or "--list" in rest or "-l" in rest.split()):
            v = A()
        else:
            hi = sub in ("push", "reset", "clean", "rebase", "checkout", "restore", "merge", "pull", "commit")
            v = Q(f"git {sub or '?'} changes the repo (you asked me not to commit/push unless told to)", "high" if hi else "medium")
    elif prog == "hyprctl":
        a2 = [a for a in args if not a.startswith("-")]
        sub = a2[0] if a2 else ""
        if sub in HYPR_READ: v = A()
        elif sub == "dispatch":
            d = a2[1] if len(a2) > 1 else ""
            if d in HYPR_DISPATCH_SAFE: v = A("window/workspace navigation")
            elif d == "exec": v = Q("launches a program: " + " ".join(a2[2:])[:120], "medium")
            elif d in ("exit",): v = Q("ends your Hyprland session", "high")
            elif d in ("killactive", "closewindow", "forcerendererreload", "dpms"): v = Q(f"dispatch {d}", "medium")
            else: v = Q(f"hyprctl dispatch {d}", "medium")
        elif sub == "reload": v = Q("reloads Hyprland config", "low")
        else: v = Q(f"hyprctl {sub}", "medium")
    elif prog == "adb":
        a2 = [a for a in args if not a.startswith("-")]
        if a2[:1] in (["devices"], ["get-state"], ["get-serialno"], ["version"]) or (a2[:2] == ["shell", "getprop"]) or (a2[:1] == ["logcat"] and "-d" in args) or a2[:2] == ["shell", "dumpsys"]:
            v = A()
        else:
            v = Q("adb action on your phone: " + joined[:100], "high" if a2[:1] in (["sideload"], ["reboot"], ["uninstall"]) else "medium")
    elif prog == "fastboot":
        v = A() if args[:1] in (["devices"], ["getvar"]) else Q("FASTBOOT can brick/wipe the device: " + joined[:100], "high")
    elif prog == "gh":
        v = A() if re.match(r"^(auth status|(repo|pr|issue|run|release|workflow) (view|list|status)|status|search)", joined) else Q("GitHub action")
    elif prog == "docker":
        v = A() if args and args[0] in ("ps", "images", "logs", "inspect", "info", "version", "stats", "volume", "network") and not re.search(r"\b(rm|prune|create|connect)\b", joined) else Q("docker action")
    elif prog in ("npm", "pnpm", "yarn", "pip", "pip3", "uv", "cargo", "go", "make", "cmake", "gradle", "flutter", "dart", "bun", "npx", "node", "python", "python3", "pipx"):
        if joined in ("--version", "-v", "-V", "version") or re.match(r"^(ls|list|view|outdated|config get|info|why|doctor|--help|-h)\b", joined): v = A()
        else: v = Q(f"{prog} runs code / modifies the project")
    elif prog in ("gtk-launch", "wl-copy", "xclip", "xsel", "printenv", "export", "set", "env"):
        v = Q(f"{prog}: launches an app / changes the clipboard / shows environment secrets", "low")
    elif prog in ("xdg-open",):
        v = A("opens in your default app") if args and not args[0].startswith("-") and (re.match(r"^https?://", args[0]) or under(args[0], HOME)) else Q("xdg-open on something unusual", "low")
    elif prog in ("kill", "pkill", "killall", "xkill"):
        v = Q("ends processes", "medium")
    elif prog in SHELLS:
        v = A() if joined in ("--version", "-V") else Q(f"{prog} runs arbitrary code")
    else:
        v = Q(f"{prog} isn't on the auto-approve list")
    return worst(redirect_verdict, v)

FETCH_OK = ("wttr.in", "api.github.com", "raw.githubusercontent.com", "github.com", "archlinux.org", "wiki.archlinux.org",
            "aur.archlinux.org", "ipinfo.io", "ifconfig.me", "api.open-meteo.com", "pypi.org", "registry.npmjs.org",
            "docs.python.org", "developer.mozilla.org", "en.wikipedia.org", "duckduckgo.com")


def trusted_helper(tok):
    """Friday's own helper, found by real path (not just by name)? Returns its name, or None."""
    import shutil
    name = os.path.basename(tok)
    if name == "friday":
        name = "project-friday"                      # the short alias of the command
    if not name.startswith("friday-") and name != "project-friday":
        return None
    mine = os.path.realpath(os.path.join(JH, "bin", name))
    if not os.path.isfile(mine):
        return None
    where = tok if "/" in tok else (shutil.which(tok) or os.path.join(JH, "bin", name))
    return name if os.path.realpath(os.path.expanduser(where)) == mine else None


def policy_bash(cmd):
    if not cmd.strip(): return A("empty")
    if "\n" in cmd.strip():
        return Q("multi-line script")
    if "$(" in cmd or "`" in cmd:
        # allow only simple, obviously harmless substitutions
        if not re.fullmatch(r"[^`$]*(\$\((date|whoami|hostname|pwd|uname[^)]*|id -un)\))?[^`$]*", cmd):
            return Q("command substitution")
    try:
        segs = split_segments(cmd)
    except ValueError:
        return Q("couldn't parse this command safely")
    verdict, prev_fetch = A(), False
    for toks, sep in segs:
        v = policy_segment(toks, prev_fetch and sep is not None or prev_fetch)
        verdict = worst(verdict, v)
        # track "curl ... |" feeding a shell
        base = os.path.basename(toks[0]) if toks else ""
        prev_fetch = base in ("curl", "wget") and sep in ("|", "|&")
    return verdict

# ------------------------------------------------------------------ tool policy
def policy(tool, inp):
    if tool == "Bash":
        cmd = inp.get("command", "")
        return policy_bash(cmd), cmd
    if tool in ("Read", "Glob", "Grep", "LS", "NotebookRead"):
        vals = [str(v) for v in inp.values()]
        if any(re.search(r"/\.local/share/friday/config\.env$|/brain/config\.env$", v) for v in vals):
            return Q("reading Friday's settings", "low"), " ".join(vals)
        if any(sensitive(v) for v in vals): return D("that path holds credentials / browser data"), " ".join(vals)
        if any(re.search(r"(^|/)\.env(\.|$)", v) for v in vals): return Q("reading a .env file (may contain secrets)", "low"), " ".join(vals)
        return A(), " ".join(vals)
    if tool in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
        path = inp.get("file_path") or inp.get("notebook_path") or ""
        if sensitive(path): return D("that path holds credentials"), path
        if protected(path): return D("that's Friday's guard, its settings or its keys: change it yourself"), path
        if under(path, *SAFE_WRITE_ROOTS): return A("Friday scratch/notes"), path
        # show what's actually being written, so you approve the change and not just a file name
        if tool == "Write":
            body = str(inp.get("content", ""))
            preview = "%s %s  (%d lines)\n%s" % (tool, path, body.count("\n") + 1, body[:900])
        elif tool == "Edit":
            preview = "%s %s\n- %s\n+ %s" % (tool, path, str(inp.get("old_string", ""))[:400], str(inp.get("new_string", ""))[:500])
        elif tool == "MultiEdit":
            edits = inp.get("edits") or []
            preview = "%s %s  (%d edits)\n" % (tool, path, len(edits)) + "\n".join("+ " + str(e.get("new_string", ""))[:200] for e in edits[:4])
        else:
            preview = f"{tool} {path}"
        if startup(path): return Q("changes something that runs at login or in every shell", "high"), preview
        if self_code(path): return Q("changes Friday's own code", "high"), preview
        sysish = under(path, "/etc", "/usr", "/boot", "/bin", "/sbin", "/lib")
        return Q(f"{tool} {path}", "high" if sysish else "medium"), preview
    if tool == "WebFetch":
        url = str(inp.get("url", ""))
        m = re.match(r"^https?://([^/?#]+)([^?#]*)(\?[^#]*)?", url)
        q = (m.group(3) or "") if m else ""
        longest = max([len(x) for x in re.split(r"[/&=?]", (m.group(2) if m else "") + q)] + [0])
        if not m or len(q) > 120 or longest > 80:
            return Q("this web request could carry data out in its address: " + url[:160], "medium"), url
        return A("reads a web page"), url
    if tool in ("WebSearch", "TodoWrite", "Task", "ExitPlanMode", "BashOutput", "KillShell", "SlashCommand"):
        return A(), json.dumps(inp)[:200]
    if tool.startswith("mcp__"):
        return Q(f"MCP tool {tool}", "medium"), tool
    return Q(f"unknown tool {tool}", "medium"), tool

# ------------------------------------------------------------------ approval round-trip
def ask_user(tool, summary, reason, risk):
    rid = uuid.uuid4().hex
    os.makedirs(os.path.join(RT, "res"), mode=0o700, exist_ok=True)
    payload = json.dumps({"id": rid, "tool": tool, "command": summary, "reason": reason, "risk": risk})
    ok = False
    try:
        r = subprocess.run(["qs", "-c", "friday", "ipc", "call", "friday", "approval", payload],
                           capture_output=True, timeout=6)
        ok = (r.returncode == 0)
    except Exception:
        ok = False
    if not ok:
        try: subprocess.run(["notify-send", "-a", "Friday", "Friday needs approval", "overlay isn't running, so I denied: " + summary[:140]], timeout=3)
        except Exception: pass
        return "deny", "No approval UI is running, so the action was not allowed. Tell the user to start Friday (qs -c friday) or run it themselves."
    res = os.path.join(RT, "res", rid)
    end = time.time() + APPROVAL_TIMEOUT
    while time.time() < end:
        if os.path.lexists(res):
            try:
                st = os.lstat(res)
                import stat as _st
                # only a plain file written by you counts (not a symlink, not someone else's file)
                v = open(res).read().strip() if (_st.S_ISREG(st.st_mode) and st.st_uid == os.getuid()) else "deny"
                os.unlink(res)
            except Exception:
                v = "deny"
            if v == "allow": return "allow", "approved by the user"
            return "deny", "The user declined this action. Do not retry it; offer an alternative or ask what they'd prefer."
        time.sleep(0.15)
    return "deny", "Approval timed out with no answer. Do not retry unless the user asks again."

def secure_runtime():
    """$XDG_RUNTIME_DIR/friday must be ours and private, or approvals could be forged by another user."""
    try:
        os.makedirs(RT, mode=0o700, exist_ok=True)
        st = os.lstat(RT)
        import stat as _st
        if _st.S_ISLNK(st.st_mode) or st.st_uid != os.getuid():
            return False
        if st.st_mode & 0o077:
            os.chmod(RT, 0o700)
        os.makedirs(SCRATCH, mode=0o700, exist_ok=True)
        return True
    except OSError:
        return False


def main():
    try:
        if os.path.exists(AUDIT) and os.stat(AUDIT).st_mode & 0o077:
            os.chmod(AUDIT, 0o600)              # the audit log is yours only
    except OSError:
        pass
    if not secure_runtime():
        emit("deny", "Friday's runtime folder isn't private (%s); refusing everything until that's fixed" % RT)
    try:
        data = json.load(sys.stdin)
    except Exception:
        emit("ask", "hook input unreadable")
    tool, inp = data.get("tool_name", ""), data.get("tool_input", {}) or {}
    (decision, reason, risk), summary = policy(tool, inp)
    if decision == "ask":
        d, why = ask_user(tool, summary, reason, risk)
        emit(d, why if d == "deny" else f"{reason} — {why}", tool, summary)
    emit(decision, reason, tool, summary)

if __name__ == "__main__":
    main()
