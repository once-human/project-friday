#!/usr/bin/env python3
"""Your most recent Claude Code sessions (terminal, desktop Code tab), nicely named.

  friday-sessions [-n 3]   JSON: [{id, cwd, project, title, named, last, first}]
  friday-sessions --name   give the newest unnamed sessions a short title with a fast model (cached)
  friday-sessions --debug  human-readable

Reads ~/.claude/projects/*/*.jsonl locally. claude.ai / Claude Desktop *chats* aren't stored on disk,
so they can't appear here. Friday's own chats are skipped (they have their own Continue row).
"""
import glob, json, os, re, subprocess, sys, time
sys.dont_write_bytecode = True

HOME = os.path.expanduser("~")
PROJ = os.path.join(HOME, ".claude", "projects")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "friday")
CACHE = os.path.join(CACHE_DIR, "session-titles.json")
NAMER = os.path.join(CACHE_DIR, "namer")
SKIP = {os.path.realpath(p) for p in (os.path.join(HOME, ".local/share/friday"), NAMER)}
os.environ["PATH"] = ":".join([HOME + "/.local/bin", HOME + "/.claude/local", "/usr/local/bin", "/usr/bin", os.environ.get("PATH", "")])


def load_cache():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except Exception:
        return {}


def save_cache(c):
    os.makedirs(CACHE_DIR, exist_ok=True)
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(c, f)
    os.replace(tmp, CACHE)


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for b in content:
            if isinstance(b, dict) and b.get("type") == "text" and b.get("text"):
                return b["text"]
    return ""


def is_noise(t):
    t = t.strip()
    return (not t or t.startswith("<") or t.startswith("Caveat:") or t.startswith("[Request interrupted")
            or t.startswith("This session is being continued"))


def scan(path):
    info = {"cwd": "", "first": "", "summary": "", "title": ""}
    try:
        with open(path, errors="replace") as f:
            for i, line in enumerate(f):
                if i > 400 and info["cwd"] and info["first"]:
                    break
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                t = o.get("type")
                if t == "summary" and o.get("summary"):
                    info["summary"] = o["summary"]
                elif t in ("custom-title", "title") and (o.get("customTitle") or o.get("title")):
                    info["title"] = o.get("customTitle") or o.get("title")
                if not info["cwd"] and o.get("cwd"):
                    info["cwd"] = o["cwd"]
                if not info["first"] and t == "user" and not o.get("isMeta"):
                    txt = text_of((o.get("message") or {}).get("content"))
                    if not is_noise(txt):
                        info["first"] = txt.strip()
    except OSError:
        pass
    return info


def heuristic(t):
    t = re.sub(r"[`*_#>\[\]]", "", t.split("\n")[0]).strip()
    t = re.sub(r"\s+", " ", t)
    if len(t) > 52:
        t = t[:52].rsplit(" ", 1)[0] + "…"
    return t[:1].upper() + t[1:]


def sessions(n):
    cache = load_cache()
    files = sorted(glob.glob(os.path.join(PROJ, "*", "*.jsonl")), key=lambda p: os.path.getmtime(p), reverse=True)
    out = []
    for p in files[:25]:
        info = scan(p)
        cwd = info["cwd"]
        if not info["first"] or not cwd or os.path.realpath(cwd) in SKIP:
            continue
        sid = os.path.splitext(os.path.basename(p))[0]
        cached = cache.get(sid)
        title = info["title"] or (cached if cached and not cached.startswith("~") else "") or info["summary"]
        out.append({
            "id": sid,
            "cwd": cwd,
            "project": os.path.basename(cwd.rstrip("/")) or cwd,
            "title": title or heuristic(info["first"]),
            "named": bool(title),
            "last": int(os.path.getmtime(p)),
            "first": info["first"][:400],
        })
        if len(out) >= n:
            break
    return out


STOP = set("""a an the to of for in on at by with and or but is are was were be been it this that these those my your
our me i you we us can could would should will please just some any do does did how what why when where which who make
let lets want need help get have has had im its into from up out about as so if then there here them they he she also
really very maybe like now again still all new same other one two using use""".split())


def local_title(first):
    """A short Title Case name from the first request, made locally. (This used to ask Claude, which quietly
    spent plan usage every time the panel opened; the local version costs nothing and is close enough.)"""
    t = first.split("\n")[0]
    t = re.sub(r"https?://\S+|`[^`]*`|(?<!\w)[~/][\w./-]+", " ", t)
    t = re.sub(r"^\W*(hey|hi|ok|okay|so|um|uh|claude|friday)\b[,\s]*", "", t, flags=re.I)
    t = re.sub(r"^(can|could|would|will) you (please )?|^(i want to|i need to|i'd like to|help me( to)?|let'?s|please)\s+",
               "", t, flags=re.I)
    words = re.findall(r"[A-Za-z][A-Za-z0-9+#.\-]*[A-Za-z0-9+#]|[A-Za-z]{2,}", t)
    keep = [w for w in words if w.lower() not in STOP][:4]
    if not keep:
        return heuristic(first)
    return " ".join(w if any(c.isupper() for c in w[1:]) or w.isupper() else w.capitalize() for w in keep)


def name_them(items):
    cache = load_cache()
    changed = False
    for s in items:
        if s["named"] or (s["id"] in cache and not cache[s["id"]].startswith("~")):
            continue
        cache[s["id"]] = local_title(s["first"])
        changed = True
    if changed:
        save_cache(cache)


def main():
    n = 3
    if "-n" in sys.argv:
        n = int(sys.argv[sys.argv.index("-n") + 1])
    items = sessions(n)
    if "--name" in sys.argv:
        name_them(items)
        items = sessions(n)
    if "--debug" in sys.argv:
        for s in items:
            print("%-28s %-22s %s  (%s)" % (s["title"][:28], s["project"][:22], time.strftime("%d %b %H:%M", time.localtime(s["last"])), "named" if s["named"] else "draft"))
        return
    print(json.dumps(items))


if __name__ == "__main__":
    main()
